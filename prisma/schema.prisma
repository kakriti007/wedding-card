generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WeddingCard {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?

  // Wedding Details
  brideName      String
  groomName      String
  weddingDate    DateTime
  weddingTime    String
  venue          String
  venueAddress   String?

  // RSVP Settings
  rsvpDeadline         DateTime
  maxGuests            Int      @default(2)
  customQuestion       String?
  customQuestionType   String?  @default("text") // text, select, radio
  customQuestionOptions String? // JSON array of options
  rsvpFormConfig       String?  // JSON object for form field configuration

  // Design Settings (JSON stored as string)
  // Contains: pages[], backgroundColor, backgroundImage, globalStyles
  design         String   @default("{\"pages\":[{\"elements\":[]}]}")

  // Music
  musicUrl       String?
  musicConfig    String? // JSON: { loop: boolean, autoplay: boolean, volume: number }

  // Gift Registries (JSON array of registry objects)
  registries     String?

  // Event Details Display Configuration (JSON object)
  // Contains: showEventDetails, showMap, mapUrl, customSections[]
  eventDetailsConfig String?

  // Status
  isPublished    Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rsvps       RSVP[]
}

model RSVP {
  id              String      @id @default(cuid())
  cardId          String
  card            WeddingCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  guestName       String
  guestEmail      String
  guestPhone      String?
  numberOfGuests  Int         @default(1)
  attending       Boolean
  customAnswer    String?
  message         String?
  dietaryRestrictions String?

  createdAt       DateTime    @default(now())

  @@index([cardId])
}
