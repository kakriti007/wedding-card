# Database Configuration
DATABASE_URL="postgresql://weddinguser:weddingpass@localhost:5432/weddingcard"

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32-minimum-32-characters

# Admin Emails (comma-separated) - ONLY THESE CAN ACCESS ADMIN PORTAL
ADMIN_EMAILS=admin1@example.com,admin2@example.com,admin3@example.com

# Email Configuration (Gmail)
# 1. Enable 2FA on Gmail: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
EMAIL_FROM=noreply@yourwedding.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-character-app-password

# RSVP Notification Emails (comma-separated) - THESE RECEIVE RSVP NOTIFICATIONS
RSVP_NOTIFICATION_EMAILS=email1@example.com,email2@example.com,email3@example.com
